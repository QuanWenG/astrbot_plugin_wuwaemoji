{
  "api_token": {
    "description": "呜哇小站 API Token",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "在 https://emoji.wuwa.games/api 点击【点击获取Token】获取（Token 仅显示一次）。留空将走匿名访问，目前会被小站拒绝（503）。"
  },
  "api_base": {
    "description": "API 地址",
    "type": "string",
    "default": "https://emoji.wuwa.games/apis/api.random-emoji.wuwa.games/v1alpha1/random",
    "hint": "一般无需修改。仅在自建 / 镜像服务时才需要改动。"
  },
  "image_format": {
    "description": "图片格式",
    "type": "string",
    "default": "original",
    "options": ["original", "webp"],
    "labels": ["原始格式（GIF / PNG）", "WebP（体积更小）"],
    "hint": "部分 QQ 客户端对 WebP 支持不佳，保持默认即可。"
  },
  "show_character_name": {
    "description": "发图前附带角色名",
    "type": "bool",
    "default": false,
    "hint": "开启后会在图片前多发送一条角色名文本。"
  },
  "timeout": {
    "description": "网络请求超时（秒）",
    "type": "int",
    "default": 20,
    "slider": {
      "min": 5,
      "max": 120,
      "step": 1
    }
  }
}
